{
  "cloud": true,
  "rules": [
    {
      "id": 24184578,
      "clientKey": "01e4b5ac-896f-37d6-b506-bbd6e2e7c02d",
      "name": "On Issue Update -> Update Rank Of Children",
      "state": "ENABLED",
      "description": "This rule updates the rank of child epics when an initiative's rank is updated. This ensures that the epics tied to that initiative are directly below the initiative itself. \n\nNOTE: THIS AUTOMATION REQUIRES A WEBHOOK TO USE. \nSteps: \n1. Get a web token from Jira through https://id.atlassian.com/manage-profile/security/api-tokens \n2. Run the command \"echo -n YOUREMAIL | base64\n(replace YOUREMAIL with your email)\n3. Copy and encrypt the base64 string\n4. Replace the current authorization key with \"basic\" followed by a space and your encrypted key. ",
      "authorAccountId": "5cab6ba65d3a4c096bc47e88",
      "actor": {
        "type": "ACCOUNT_ID",
        "value": "557058:f58131cb-b67d-43c7-b30d-6b58d40bd077"
      },
      "created": 1737143814065,
      "updated": 1742485205816,
      "trigger": {
        "id": "671259623",
        "component": "TRIGGER",
        "parentId": null,
        "conditionParentId": null,
        "schemaVersion": 1,
        "type": "jira.issue.event.trigger:updated",
        "value": {
          "eventKey": "jira:issue_updated",
          "issueEvent": "issue_updated"
        },
        "children": [],
        "conditions": [],
        "connectionId": null
      },
      "components": [
        {
          "id": "671259624",
          "component": "ACTION",
          "parentId": null,
          "conditionParentId": null,
          "schemaVersion": 1,
          "type": "codebarrel.action.log",
          "value": "{{#changelog.Rank}}{{fromString}} - {{toString}}{{/changelog.Rank}}",
          "children": [],
          "conditions": [],
          "connectionId": null
        },
        {
          "id": "671259625",
          "component": "CONDITION",
          "parentId": null,
          "conditionParentId": null,
          "schemaVersion": 1,
          "type": "jira.comparator.condition",
          "value": {
            "first": "{{changelog.Rank}}",
            "second": "",
            "operator": "NOT_EQUALS"
          },
          "children": [],
          "conditions": [],
          "connectionId": null
        },
        {
          "id": "671259626",
          "component": "ACTION",
          "parentId": null,
          "conditionParentId": null,
          "schemaVersion": 1,
          "type": "codebarrel.action.log",
          "value": "RANK WAS CHANGED",
          "children": [],
          "conditions": [],
          "connectionId": null
        },
        {
          "id": "671259627",
          "component": "ACTION",
          "parentId": null,
          "conditionParentId": null,
          "schemaVersion": 1,
          "type": "jira.lookup.issues",
          "value": {
            "id": "_customsmartvalue_id_1737146346551",
            "name": {
              "type": "FREE",
              "value": "lookupIssues"
            },
            "type": "JQL",
            "query": {
              "type": "SMART",
              "value": "parent = {{triggerIssue.key}} Order By Rank"
            },
            "lazy": false
          },
          "children": [],
          "conditions": [],
          "connectionId": null
        },
        {
          "id": "671259628",
          "component": "ACTION",
          "parentId": null,
          "conditionParentId": null,
          "schemaVersion": 1,
          "type": "jira.create.variable",
          "value": {
            "id": "_customsmartvalue_id_1737146359746",
            "name": {
              "type": "FREE",
              "value": "epicIds"
            },
            "type": "SMART",
            "query": {
              "type": "SMART",
              "value": "[   {{#lookupIssues}} \"{{key}}\" {{^last}}, {{/}} {{/}}   ]"
            },
            "lazy": false
          },
          "children": [],
          "conditions": [],
          "connectionId": null
        },
        {
