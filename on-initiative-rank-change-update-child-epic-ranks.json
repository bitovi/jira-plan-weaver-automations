          "component": "ACTION",
          "parentId": null,
          "conditionParentId": null,
          "schemaVersion": 1,
          "type": "jira.issue.outgoing.webhook",
          "value": {
            "url": "https://bitovi-training.atlassian.net/rest/agile/1.0/issue/rank",
            "headers": [
